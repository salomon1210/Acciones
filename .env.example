# ====================================================================
# Investment Command — variables de entorno
# Copiá este archivo a `.env.local` y completá las keys que tengas.
# Todas son opcionales: sin key, cada feature usa yfinance o mock data.
# ====================================================================

# Base de datos local (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Backend Python
PY_BACKEND_URL="http://127.0.0.1:8001"

# --- AI ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- Market data ---
# https://finnhub.io/ (free: 60 calls/min)
FINNHUB_API_KEY=""

# https://www.alphavantage.co/ (free: 25 calls/day)
ALPHAVANTAGE_API_KEY=""

# https://site.financialmodelingprep.com/ (free: 250 calls/day)
FMP_API_KEY=""

# --- News ---
# https://newsapi.org/ (free: 100 calls/day)
NEWSAPI_KEY=""

# https://www.marketaux.com/ (free: 100 calls/day con sentiment)
MARKETAUX_API_KEY=""

# --- Crypto ---
# https://www.coingecko.com/en/api (free: 30 calls/min, no requiere key en free tier)
COINGECKO_API_KEY=""

# Binance: SIEMPRE usar API keys read-only, sin permisos de retiro
# https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# --- Macro ---
# https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=""

# --- Briefing & alertas ---
BRIEFING_CRON="30 8 * * *"
ALERTS_CRON="* * * * *"

# Opcional: webhook para alertas externas (Telegram bot, Discord)
ALERTS_WEBHOOK_URL=""
